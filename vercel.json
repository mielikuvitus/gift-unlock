{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/gift-unlock/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/gift-unlock/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/gift-unlock", "destination": "/gift-unlock/index.html" },
    { "source": "/gift-unlock/:path*", "destination": "/gift-unlock/index.html" }
  ]
}
