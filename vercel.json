{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/gift-unlock/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/gift-unlock", "destination": "/gift-unlock/index.html" },
    { "source": "/gift-unlock/:path*", "destination": "/gift-unlock/index.html" }
  ]
}
